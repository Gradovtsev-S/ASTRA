# =============================================
# ДОКУМЕНТАЦИЯ И ЭКСПОРТ
# =============================================

# Экспортированные PDF из SolidWorks (генерируются из исходников)
# Раскомментируй если не хочешь хранить PDF в репо
# *.pdf

# Рендеры и превью (тяжёлые файлы)
*.png
*.jpg
*.jpeg
*.gif
*.bmp
# Исключение — храним картинки в папке docs/
!docs/**/*.png
!docs/**/*.jpg

# =============================================
# РАЗНОЕ
# =============================================

# Логи
*.log
logs/

# Переменные окружения (токены, ключи)
.env
.env.local
secrets.h
credentials.h

# Telegram bot token — никогда не коммитить!
*token*
*secret*
*password*
*credential*